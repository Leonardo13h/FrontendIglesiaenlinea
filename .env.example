# Copia este archivo como ".env" y completa los valores. El .env NO se sube a git.

# Dirección del sistema administrativo (botón "Entrar" del menú), sin "/" al final.
# Si se deja vacío, el botón apunta a http://localhost:5174/login
VITE_DASHBOARD_URL=

# Datos del FTP del hosting (los usa "npm run deploy")
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# Carpeta del servidor donde se publica la página (ej. /public_html)
FTP_REMOTE_ROOT=/
